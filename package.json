{
  "name": "spec-to-linear",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "stl": "tsx apps/cli/src/main.ts",
    "mcp": "tsx apps/mcp/src/server.ts",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "lint:boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint:boundaries && pnpm test",
    "mcp:call": "tsx apps/mcp/src/call.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.4.0",
    "tsx": "^4.23.0",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}